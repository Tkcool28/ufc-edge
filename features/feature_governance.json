{
  "governance_schema_version": 1,
  "governance_version": "1.0.0",
  "feature_contract_version": "0.1.2-draft",
  "catalog_authority": "features/feature_catalog.yaml",
  "identity_policy": {
    "convention": "<LAYER>_<CONCEPT>_V<SEMANTIC_MAJOR>",
    "layer_prefixes": {
      "fighter_state": "FS",
      "context": "CTX",
      "matchup_interaction": "MX",
      "opponent_adjusted": "OA",
      "simulator_component": "SIM",
      "research": "RES",
      "unsupported": "UNSUP"
    },
    "canonical_prefix_normalization": "If canonical_name begins with the same durable layer prefix plus '_' (case-insensitive), remove exactly that one redundant prefix from the concept token before constructing feature_id.",
    "semantic_major_suffix": "The terminal _V<number> is the semantic_version major generation only. It is not the feature-contract version, methodology version, model version, consumer version, or implementation version.",
    "stable_under_rename": true,
    "never_recycled": true,
    "semantic_change_requires_new_id": true,
    "materialized_columns_are_variants_not_concepts": true,
    "authority_boundary": "Because governance V1 is still pre-merge, malformed IDs may be corrected in place. After PR #31 merges, durable feature IDs are immutable historical identities and changes require the documented lifecycle/migration process."
  },
  "lifecycle_states": [
    "ACTIVE",
    "DEFERRED",
    "RESEARCH_ONLY",
    "SIMULATOR_REQUIRED",
    "DATA_REQUIRED",
    "PROXY_ONLY",
    "DEPRECATED",
    "SUPERSEDED",
    "UNSUPPORTED"
  ],
