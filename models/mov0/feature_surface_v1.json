  "fighter_order_invariance": {
    "rule": "No model-facing numeric feature may retain Fighter-1/Fighter-2 sign or side identity.",
    "paired_numeric_source_preprocessing": "For each semantic f1/f2 pair, fit one median on pooled non-null values from both fighter-side training columns; impute both sides with that same training-only value before symmetric transformation.",
    "paired_numeric_transformations": ["mean(f1,f2)", "abs(f1-f2)"],
    "directional_matchup": {
      "columns": [
        "mx__knockdown_creation_vs_vulnerability__f1_vs_f2__career__raw",
        "mx__knockdown_creation_vs_vulnerability__f2_vs_f1__career__raw"
      ],
      "preprocessing": "fit one median on both directional columns pooled within training history",
      "transformations": ["mean(f1_vs_f2,f2_vs_f1)", "abs(f1_vs_f2-f2_vs_f1)"]
    },
    "shared_context": ["scheduled_rounds", "ctx__title_bout", "ctx__weight_class"],
    "mandatory_future_test": "Swap Fighter 1 and Fighter 2, including every paired/directional source column, and require predicted STANDARD_FINISH probability to be equal within atol=1e-12, rtol=0."
