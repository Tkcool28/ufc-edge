  "concept_review": [
    {"concept":"scheduled_rounds","mechanism":"More scheduled fight time creates more opportunity for a finish before the terminal decision.","class":"direct","decision":"B1_CONTEXT"},
    {"concept":"title_bout","mechanism":"Title-bout context changes scheduled duration and competitive setting beyond raw historical prevalence.","class":"indirect","decision":"B1_CONTEXT"},
    {"concept":"weight_class","mechanism":"Finish frequency can differ structurally by division because size and fight-style distributions differ.","class":"indirect","decision":"B1_CONTEXT"},
    {"concept":"prior_fight_count","mechanism":"Observed historical experience changes how much stable fighter-specific finish tendency is available and may itself proxy fight maturity.","class":"indirect","decision":"B1_CONTEXT"},
    {"concept":"early_finish_profile","mechanism":"Prior first-round finish wins and losses directly measure a fighter pair's history of early terminal outcomes.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"finish_method_win_profile","mechanism":"Prior KO/TKO and submission win rates directly measure demonstrated finish creation.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"finish_method_loss_profile","mechanism":"Prior KO/TKO and submission loss rates directly measure demonstrated finish vulnerability.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"knockdown_creation_vs_vulnerability","mechanism":"Directional knockdown creation relative to opponent vulnerability directly represents a damage pathway that can produce a finish.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"knockdown_rate","mechanism":"Knockdowns created and allowed per exposure measure severe striking events that precede many KO/TKO finishes.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"submission_attempt_rate","mechanism":"Submission attempts created and faced measure direct grappling threats and vulnerability on the submission finish pathway.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"takedown_pressure","mechanism":"Takedown attempts created and faced measure how often a fight is pushed toward grappling states where submissions and ground finishes can occur.","class":"direct","decision":"MOV0_MIN"},
    {"concept":"knockdown_efficiency","mechanism":"Knockdowns per landed/absorbed significant strike add strike-normalized power and durability level beyond time-based knockdown rate.","class":"direct","decision":"MOV0_FULL"},
    {"concept":"sig_strike_flow","mechanism":"Significant strikes landed and absorbed per minute represent sustained damage flow that can raise or suppress terminal striking opportunity.","class":"indirect","decision":"MOV0_FULL"},
    {"concept":"sig_strike_efficiency","mechanism":"Accuracy and defense describe how efficiently damaging exchanges are delivered and avoided.","class":"indirect","decision":"MOV0_FULL"},
    {"concept":"sig_environment_mix","mechanism":"Clinch and ground significant-strike shares distinguish environments with different finish pathways.","class":"indirect","decision":"MOV0_FULL"},
    {"concept":"sig_target_mix","mechanism":"Head and body target shares encode where damaging offense is directed.","class":"indirect","decision":"MOV0_FULL"},
    {"concept":"takedown_conversion","mechanism":"Takedown success and defense indicate whether grappling pressure becomes realized positional opportunity.","class":"indirect","decision":"MOV0_FULL"},
    {"concept":"control_rate","mechanism":"Control can either create finish opportunity or suppress action and preserve a decision.","class":"ambiguous","decision":"DEFER"},
    {"concept":"reversal_rate","mechanism":"Reversals may represent either escape from danger or creation of danger.","class":"ambiguous","decision":"DEFER"}
  ],
  "unapproved_columns_policy": "hard_fail",
  "new_missingness_predictors_allowed": false
